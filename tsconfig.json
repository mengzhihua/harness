{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["packages/**/*.ts", "eval/**/*.ts"]
}
