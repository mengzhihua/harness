{
  "name": "harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "harness": "tsx packages/cli/src/main.ts",
    "test": "tsx --test packages/compose/src/*.test.ts packages/core/src/*.test.ts eval/usability/*.test.ts"
  },
  "bin": {
    "harness": "./packages/cli/bin/harness.mjs"
  },
  "devDependencies": {
    "@harness/cli": "workspace:*",
    "@harness/compose": "workspace:*",
    "@harness/core": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
